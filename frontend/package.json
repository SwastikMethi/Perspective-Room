{
  "name": "perspective-room-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../handoff/contracts/openapi.yaml -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../handoff/contracts/openapi.yaml -o /tmp/pr-schema-check.d.ts && diff -q src/api/schema.d.ts /tmp/pr-schema-check.d.ts",
    "format": "prettier --write src tests ../tests/e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^1.57.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
