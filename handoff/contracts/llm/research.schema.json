{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research",
  "type": "object",
  "properties": {
    "query": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qualification": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "statement",
          "source_ids",
          "qualification"
        ],
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "query",
    "findings",
    "unknowns"
  ],
  "additionalProperties": false
}
