{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Summary",
  "type": "object",
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "directions",
              "disagreements",
              "assumptions",
              "questions",
              "experiments"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "source_message_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "text",
                "source_message_ids",
                "source_ids"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sections"
  ],
  "additionalProperties": false
}
