# Copy into the implemented application as .env. Never commit real values.
APP_PROVIDER_MODE=live
OPENAI_API_KEY=
TYPESAFE_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_RESEARCH_MODEL=gpt-6.1-sol
JEV_MODEL=jev-1.13.0
# Empty means omit the provider-specific option.
OPENAI_REASONING_EFFORT=
DATABASE_URL=postgresql+asyncpg://perspective:local_development_only@db:5432/perspective
POSTGRES_DB=perspective
POSTGRES_USER=perspective
POSTGRES_PASSWORD=local_development_only
APP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_PUBLIC_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# No default dollar cap. Set only if you want one.
MAX_SESSION_USD=
# Set APP_PROVIDER_MODE=demo explicitly for deterministic offline fixtures.
# Only if your OpenAI project is bound to a regional host (data residency),
# e.g. OPENAI_BASE_URL=https://us.api.openai.com/v1 . Leave empty for the default host.
OPENAI_BASE_URL=
